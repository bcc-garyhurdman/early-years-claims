# Path to the SQLite database file (default: ./data/early-years.db)
DATABASE_PATH=./data/early-years.db

# Third-party claims API. Must return JSON: an array of claim objects
# (or { "data": [...] } / { "claims": [...] }) keyed by the field names, e.g. "Impulse ID".
# Leave blank in development to use the built-in mock endpoint (/api/mock-claims).
CLAIMS_API_URL=
# Optional: sent as "Authorization: Bearer <key>"
CLAIMS_API_KEY=

# Password for the initial "admin" manager account, created on first run only.
INITIAL_ADMIN_PASSWORD=ChangeMe123!

# Session cookies are marked Secure (HTTPS-only) in production. Set to false if served over plain HTTP.
COOKIE_SECURE=
